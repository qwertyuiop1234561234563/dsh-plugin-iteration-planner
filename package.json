{
  "name": "dsh-plugin-iteration-planner",
  "version": "0.1.0",
  "description": "企业级研发迭代规划智能 Agent —— 基于 DeepSeek Harness / Cordis 的独立插件（Kahn 拓扑 + AOE 关键路径 + 风险扫描 + 燃尽图）",
  "type": "module",
  "license": "MIT",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./algorithm": "./src/algorithm/index.ts",
    "./service": "./src/service/planner-service.ts"
  },
  "dsh": {
    "bundle": "./cordis.patch.yml"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "demo": "tsx demo/demo.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "api:start": "tsx src/api/standalone.ts",
    "api:dev": "tsx watch src/api/standalone.ts",
    "web:install": "npm --prefix web install",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "web:preview": "npm --prefix web run preview",
    "build:web": "npm --prefix web run build",
    "py:install": "python -m pip install -r python/requirements-dev.txt",
    "py:start": "python python/run.py",
    "py:test": "python -m pytest -c python/pyproject.toml"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-system-prompt": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-util-values": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-brand": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/dsh-util-values": "0.2.0-rc.2",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/static": "^10.1.6",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@fastify/websocket": "^11.3.4",
    "fastify": "^5.12.5",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  }
}
