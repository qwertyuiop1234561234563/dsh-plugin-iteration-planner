# ============================================================================
# 企业级研发迭代规划智能 Agent · 环境变量样例
#   复制为 .env 后按需修改；`npm run api:start` 会自动加载（Node 20.12+）。
#   docker compose 亦会自动读取同目录 .env。
# ============================================================================

# ------------------------------ HTTP 服务 ---------------------------------
# 监听地址 / 端口
API_HOST=0.0.0.0
API_PORT=8080
# REST 路由前缀
API_BASE_PATH=/api
# WebSocket 事件推送路径
API_WS_PATH=/ws
# CORS 允许来源：* 表示全部放开；多个来源用英文逗号分隔
API_CORS_ORIGIN=*
# Bearer 访问令牌：留空表示不启用鉴权（生产环境务必配置）
API_TOKEN=
# 日志级别：trace / debug / info / warn / error
LOG_LEVEL=info
# 是否启用 Swagger UI（访问 <API_BASE_PATH>/docs）
API_ENABLE_SWAGGER=true

# ------------------------------ 存储驱动 ----------------------------------
# memory（内存，重启丢失，适合演示）| postgres（持久化，生产推荐）
STORAGE_DRIVER=memory

# PostgreSQL 连接（STORAGE_DRIVER=postgres 时生效）
# 方式一：直接给完整连接串（优先级高于离散参数）
DATABASE_URL=postgres://planner:planner@localhost:5432/iteration_planner
# 方式二：离散参数（未设置 DATABASE_URL 时使用）
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=iteration_planner

# ------------------------------ 前端静态资源 ------------------------------
# 指向 web 构建产物目录（存在则同域托管 SPA，并支持 history 路由回落）
WEB_STATIC_DIR=

# ------------------------------ 规划器参数 --------------------------------
# LLM 输出异常时是否自动降级为规则拆解（true 更稳健）
PLANNER_FALLBACK_TO_RULE=true
# 单开发人单日工时（用于工期折算与过载校验）
PLANNER_WORK_HOURS_PER_DAY=8
# 人员过载阈值（小时）
PLANNER_OVERLOAD_THRESHOLD=8

# ------------------------- LLM 网关（可选，OpenAI 兼容） -------------------
# 三项齐全才启用 LLM 主路径；否则使用规则实现（离线可复现）
#
# 阿里云百炼（Model Studio）接入示例（OpenAI 兼容端点，可直接填下面三项）：
#   LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   LLM_API_KEY=sk-xxxxxxxxxxxx（控制台「API-KEY 管理」创建；密钥只放本地 .env，禁止提交）
#   LLM_MODEL=qwen-plus
# 注意：新人免费额度按模型发放，仅「华北2（北京）」地域享有，开通后 90 天内有效；
#       免费额度用尽后已实名账号会自动转为按量计费，请按需选择模型。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ============================================================================
# Python 对外服务（FastAPI + Agent 编排层）
#   Python 不承载算法：通过 ENGINE_BASE_URL 调用上面的 TypeScript 引擎。
#   本地开发：先启动引擎（npm run api:start），再启动 Python（python/run.py）。
# ============================================================================

# --------------------------- 内部算法引擎地址 ---------------------------
# 本地开发指向引擎默认端口；docker compose 内为容器名 http://engine:8080
ENGINE_BASE_URL=http://127.0.0.1:8080
ENGINE_TIMEOUT_SECONDS=60
# 建立连接超时（快速失败）；读取沿用 ENGINE_TIMEOUT_SECONDS
ENGINE_CONNECT_TIMEOUT_SECONDS=5
# 连接池上限 / 保活连接数
ENGINE_MAX_CONNECTIONS=100
ENGINE_MAX_KEEPALIVE_CONNECTIONS=20
# 指数退避重试（仅对连接失败与幂等方法的 5xx 生效，避免非幂等写操作重复执行）
ENGINE_RETRY_ATTEMPTS=2
ENGINE_RETRY_BASE_DELAY=0.2
ENGINE_RETRY_MAX_DELAY=2.0
# 断路器：连续失败阈值 / 冷却恢复时间（秒）
ENGINE_BREAKER_THRESHOLD=5
ENGINE_BREAKER_RECOVERY_SECONDS=30

# ------------------------------ Agent 编排 ------------------------------
# function calling 循环的最大步数（防止模型死循环调用工具）
AGENT_MAX_STEPS=8
AGENT_TEMPERATURE=0.2
# 送入模型的上下文字符预算（约 4 字符 ≈ 1 token，超限自动裁剪最旧历史）
AGENT_MAX_CONTEXT_CHARS=96000
# 会话存储：memory（默认）| redis（多副本/多 worker 共享）
SESSION_STORE=memory
# 会话空闲过期时间（秒）
AGENT_SESSION_TTL_SECONDS=3600
# session_store=redis 时必填（需额外安装可选依赖：pip install redis）
REDIS_URL=

# --------------------------- 安全 / 可观测 / 运维 ---------------------------
# 单客户端 IP 每分钟请求上限（令牌桶）；0 表示关闭限流（生产建议开启）
# 注意：限流为「单进程内存」实现，API_WORKERS>1 时每个 worker 独立计数，
#       实际全局配额 ≈ 本值 × worker 数；多副本建议在网关统一限流。
API_RATE_LIMIT_PER_MINUTE=0
# 限流突发容量（0 表示与每分钟上限相同）
API_RATE_LIMIT_BURST=0
# 是否注入安全响应头（nosniff / X-Frame-Options / Referrer-Policy 等）
API_SECURITY_HEADERS=true
# uvicorn 进程数；>1 时需 SESSION_STORE=redis 且在网关层做 WS 粘性会话
API_WORKERS=1
# 断线重连时向前端重放最近 N 条事件（0 表示关闭）
WS_REPLAY_SIZE=20

# ------------------------------ LLM 重试 ----------------------------------
# LLM 调用额外重试次数（连接失败 / 429 / 5xx 生效）
LLM_RETRY_ATTEMPTS=2
LLM_RETRY_BASE_DELAY=0.5

# ============================================================================
# 知识库（RAG）与长期记忆（Python 侧可选增强能力）
#   依赖向量化模型；未配置时自动降级为「纯算法 + 无记忆」模式，主链路不受影响。
#   向量库使用 Chroma 本地持久化，运行期数据落在 python/.data/chroma（已 gitignore）。
# ============================================================================

# ------------------------------ 向量化模型 --------------------------------
# 端点 / 密钥留空则自动回落 LLM_BASE_URL / LLM_API_KEY（百炼同一端点兼做 embeddings）
#   EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v4
# 输出维度：text-embedding-v4 支持 2048/1536/1024/768/512/256/128/64（默认 1024）
EMBEDDING_DIMENSIONS=1024
# 单次请求文本条数（百炼上限较小，保守按 10 条分批）
EMBEDDING_BATCH_SIZE=10
EMBEDDING_TIMEOUT_SECONDS=60
# 向量化调用重试（连接失败 / 429 / 5xx 生效）
EMBEDDING_RETRY_ATTEMPTS=2
EMBEDDING_RETRY_BASE_DELAY=0.5

# ------------------------------- 向量库 -----------------------------------
# 向量库驱动（当前仅 chroma）
VECTOR_STORE=chroma
# Chroma 持久化目录；留空使用 python/.data/chroma
CHROMA_DIR=

# ------------------------------ 知识库检索 --------------------------------
# 分块目标字符数 / 相邻块重叠字符数
KB_CHUNK_SIZE=800
KB_CHUNK_OVERLAP=120
# 默认召回条数（人工检索与 agentic 工具）
KB_TOP_K=4
# 混合检索：稠密向量 + BM25 稀疏 → RRF 融合（false 则退化为纯向量检索）
KB_HYBRID=true
# RRF 融合平滑常数（经验值 60）
KB_RRF_K=60
# 单文档体积上限（字节）与知识库文档总数上限
KB_MAX_DOCUMENT_BYTES=20971520
KB_MAX_DOCUMENTS=500
# 对话时是否自动注入命中的知识库片段（agentic kb_search 工具始终可用）
KB_AUTO_INJECT=true
# 自动注入的召回条数（通常小于人工检索）
KB_INJECT_TOP_K=3

# ------------------------------ 长期记忆 ----------------------------------
# 记忆总开关（提取 + 语义召回）
MEMORY_ENABLED=true
# 是否每轮对话后自动提取记忆（关闭则仅支持手工新增）
MEMORY_EXTRACT=true
# 每轮注入上下文的最大记忆条数
MEMORY_TOP_K=4
# 去重阈值：新记忆与既有记忆余弦相似度 ≥ 该值视为重复，跳过写入
MEMORY_DEDUP_THRESHOLD=0.92
# 记忆总量上限（防止无界增长）
MEMORY_MAX_ITEMS=2000

# ------------------------------ Docker 部署 -------------------------------
# docker compose 暴露到宿主机的端口（Python 对外服务）
APP_PORT=8080